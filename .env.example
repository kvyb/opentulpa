# OpenTulpa now keeps non-secret runtime defaults in `opentulpa.config.yaml`.
# Keep secrets and deployment-only environment variables here.

# Required for the Deep Agents model through OpenRouter or another compatible endpoint.
OPENAI_COMPATIBLE_API_KEY=
# OpenAI-compatible base URL (default provider endpoint in this repo).
# Change this when using another OpenAI-compatible provider.
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# Optional JSON map used by AgentSpecs, for example {"fast":"openai/gpt-4.1-mini"}.
MODEL_ALIASES={}
# Ordered model failover chain; JSON arrays and comma-separated values are accepted.
LLM_FALLBACK_MODELS=z-ai/glm-5.2
# Optional per-model OpenRouter provider order as JSON.
LLM_PROVIDER_ORDER={"z-ai/glm-5.2":["z-ai/fp8","fireworks","deepinfra/fp4"]}

# Required for unattended public deployments. A local `opentulpa` generates and reuses this
# privately, so local users do not need to configure or handle it.
OPENTULPA_OWNER_TOKEN=

# Optional: Exa search/answer provider. If set, web_search uses Exa.
# Otherwise web_search uses Perplexity Sonar via OpenRouter.
EXA_API_KEY=
# Optional: Perplexity/Sonar model override through OpenRouter.
OPENROUTER_WEB_SEARCH_MODEL=

# Optional business knowledge oracle model override (normally set in opentulpa.config.yaml)
BUSINESS_KNOWLEDGE_ORACLE_MODEL=

# Optional: Langfuse traces for turns, LLM calls, tools, and side-effect summaries.
# OpenTulpa only sends external telemetry when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional override. Defaults to https://us.cloud.langfuse.com.
LANGFUSE_BASE_URL=
# Optional trace tag/metadata label. Railway service/environment values are also captured.
LANGFUSE_DEPLOYMENT_TAG=
# Optional Langfuse filter environment. If unset, derived from deploy tag/Railway identity.
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_CONTENT_LEVEL=full_debug

# Optional single data root. Local `opentulpa` defaults to
# ${XDG_DATA_HOME:-$HOME/.local/share}/opentulpa. Cloud deployments should set it.
# Railway example: mount a volume at /app/opentulpa_data and set
# OPENTULPA_DATA_ROOT=/app/opentulpa_data
OPENTULPA_DATA_ROOT=

# Optional canonical Git checkout used by the immutable managed bootstrap. Direct mode
# cannot self-replace; mutable release containers never receive this checkout.
EVOLUTION_SOURCE_REPOSITORY=

# Managed self-replacing runtime. These are consumed only by `opentulpa-bootstrap`;
# mutable releases never receive the source checkout or container socket.
OPENTULPA_RECOVERY_TOKEN=
OPENTULPA_INGRESS_TOKEN=
OPENTULPA_BOOTSTRAP_STATE_ROOT=.opentulpa/bootstrap
OPENTULPA_RELEASE_WORKSPACE=.opentulpa/release-data
# Pre-created, administrator-restricted egress network for production releases.
OPENTULPA_RELEASE_EGRESS_NETWORK=
# Stable-host ceiling for source-overlay worker destinations. The network/firewall
# must enforce the same list; Telegram's API is included by default.
OPENTULPA_CAPABILITY_ALLOWED_HOSTS=
# Reviewed local image containing the locked Python environment used by source overlays.
OPENTULPA_RELEASE_BASE_IMAGE=opentulpa-runtime-base:0.1.0
# Reviewed local no-network image used for tenant workspace commands. Managed
# startup resolves this tag to an immutable local image ID in the stable host.
SANDBOX_IMAGE=opentulpa-tenant-sandbox:0.1.0
OPENTULPA_RELEASE_HOST_GATEWAY=host.docker.internal
# Optional explicit Docker or Podman executable. Local startup auto-detects one.
OPENTULPA_CONTAINER_CLI=
# Set to 0 to avoid opening the local host administration console.
OPENTULPA_OPEN_BROWSER=auto
# Optional comma-separated dependency bundles retained by start.sh and baked into
# managed runtime images. Values: browser, integrations, documents, research, bundled.
OPENTULPA_EXTRAS=

# Optional: Telegram bot
TELEGRAM_BOT_TOKEN=
# Optional but recommended: Telegram webhook secret token validated on /webhook/telegram
TELEGRAM_WEBHOOK_SECRET=
# Optional public base URL for auto webhook registration on startup (cloud deploys)
# Example: https://your-app.up.railway.app
PUBLIC_BASE_URL=
# Railway fallback: if PUBLIC_BASE_URL is empty and RAILWAY_PUBLIC_DOMAIN is present,
# startup auto-configures webhook with https://$RAILWAY_PUBLIC_DOMAIN/webhook/telegram
# Optional: restrict bot access to specific Telegram accounts
# comma-separated usernames (without @), e.g. myusername,altuser
TELEGRAM_ALLOWED_USERNAMES=
# comma-separated numeric Telegram user IDs, e.g. 123456789
TELEGRAM_ALLOWED_USER_IDS=
# Optional generic owner id for dashboard deployments before Telegram numeric id is known.
# With exactly one TELEGRAM_ALLOWED_USERNAMES value, first message from that username binds its numeric id here.
OPENTULPA_OWNER_CUSTOMER_ID=
# Optional: Composio Tool Router integration for external SaaS auth/tool access
COMPOSIO_API_KEY=

# Optional: Browser Use Cloud hosted browsers.
# Recommended for browser tasks that benefit from persistent tenant profiles,
# proxying, and managed browser infrastructure.
BROWSER_USE_API_KEY=
